# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roadpro

# Security & Authentication
JWT_SECRET=your-secure-jwt-secret-key
CSRF_SECRET=your-secure-csrf-token-secret
NODE_ENV=development

# AI Service API Keys (Frontend - Vite)
# These must be prefixed with VITE_ to be accessible in the browser
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key
VITE_HUGGINGFACE_API_KEY=your-huggingface-api-key
VITE_HUGGINGFACE_MODEL_ID=google/flan-t5-base

# AI Service API Keys (Backend)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Storage Encryption
VITE_STORAGE_KEY=your-secure-local-storage-encryption-key
