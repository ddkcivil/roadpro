# MongoDB Atlas (from Vercel integration)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&amp;w=majority

# Supabase (existing)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Other
VITE_USE_MOCK_MONGO=false  # Set true for mock fallback
