# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard/project/[project-id]/settings/api

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Client-side (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: Never commit real keys! Copy to .env.local for local dev.
# For Vercel: Add these as Environment Variables in dashboard.
