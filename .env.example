# Supabase Frontend Configuration (VITE_ prefix required for browser)
# Get from https://supabase.com/dashboard/project/[your-project]/settings/api
# 1. Project URL → VITE_SUPABASE_URL  
# 2. anon/public key → VITE_SUPABASE_ANON_KEY (NOT service_role key)

VITE_SUPABASE_URL=https://abcdefghijklmnopqrstuvwxyz.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzU5MDQwMDAsImV4cCI6MjA1MTQ4MDAwfQ.example1234567890abcdefghijklmnopqrstuvwxyz1234567890

# Backend API (separate folder - api/.env)
# SUPABASE_URL=https://...
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=... (server-only, dangerous in browser)

# Development
VITE_USE_MOCK_SUPABASE=false

# Restart `npm run dev` after changes!
# Check browser console for diagnostics:
# [Supabase] Env Check: {keyLength: 150+, hasValidUrl: true}
